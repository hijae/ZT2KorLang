    <cell width="32" pady="10">
     <img src="ui/zoopedia/fact-bullet.tga" sx="0" sy="0" sw="32" sh="32" />
    </cell>
    <cell width="202" pady="10">
     <color r="255" g="255" b="255"><font name="Gulim" size="10">The Bonnethead Shark is of great importance for commercial fishing. This shark is also hunted by fishers.</font></color>
    </cell>
